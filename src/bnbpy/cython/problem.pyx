from libcpp cimport bool

import copy

from bnbpy.cython.solution cimport Solution
from bnbpy.cython.status cimport OptStatus


cdef class Problem:
    """
    Abstraction for an optimization problem

    IMPORTANT: Always remember to implement the methods:
        - `calc_bound`
        - `is_feasible`
        - `branch`

    IMPORTANT: Always remember to call super().__init__()
    in the constructor of the derived class.

    Although not implemented using an abstract base class,
    due to Cython limitations, these methods are essential for the
    correct functioning of the branch-and-bound algorithm.

    The method `warmstart` is optional,
    but it can be used to provide a warmstart solution.

    Note that the Cython implementation uses static typing,
    so the `solution` attribute class must be a subclass of
    `bnbpy.cython.solution.Solution`.
    """

    def __init__(self) -> None:
        self.solution = Solution()

    @property
    def lb(self):
        """Lower bound of the (sub)problem (from its solution)"""
        return self.get_lb()

    cpdef double calc_bound(self):
        """
        Returns a lower bound of the (sub)problem. By default,
        the subproblems' nodes are initialized with the same lower bounds
        as the parent problems' nodes.

        Returns
        -------
        float
            Lower bound of the (sub)problem
        """
        raise NotImplementedError("Must implement `calc_bound` method")

    cpdef void compute_bound(self):
        """Computes the lower bound via `calc_bound` and sets it in the
        solution (called by the search; not intended to be overridden)."""
        lb = self.calc_bound()
        self.solution.set_lb(lb)

    cpdef bool is_feasible(self):
        """
        Returns `True` if the problem in its complete
        form has a feasible solution.

        It is called after a new node is selected for evaluation
        from the active queue, if its lower bound is better than
        the best solution found so far, and before branching.

        Returns
        -------
        bool
            Feasibility check
        """
        raise NotImplementedError("Must implement `is_feasible` method")

    cpdef list[Problem] branch(self):
        """Generates child nodes (problems) by branching.

        Be careful not to modify attributes shared among nodes.
        It is also recommended to avoid performing expensive copy
        operations, by only modifying the attributes
        that differ between nodes.

        Returns
        -------
        Sequence[Problem]
            List of child problems generated by branching
            (an empty list or None if there are no children).
            Note that Cython requires a ``list``; other sequence
            types raise a ``TypeError``.
        """
        raise NotImplementedError("Must implement `branch` method")

    cpdef bool check_feasible(self):
        cdef:
            bool feas
        feas = self.is_feasible()
        if feas:
            self.solution.set_feasible()
        else:
            self.solution.set_infeasible()
        return feas

    cpdef void set_solution(self, Solution solution):
        self.solution = solution
        if self.solution.status == OptStatus.NO_SOLUTION:
            self.compute_bound()

    cpdef Problem warmstart(self):
        """Placeholder for warmstart implementation.
        If the problem has a warmstart function that returns a feasible
        problem state, it will be used at the begining of the search tree.

        Be careful not to modify the current problem instance,
        but return a new one.

        Returns
        -------
        Optional[Problem]
            Problem modified in a warmstart form, or None
            (in case not implemented)
        """
        return None

    cpdef Problem primal_heuristic(self):
        """Placeholder for primal heuristic implementation.
        If implemented, it should return a new problem in a feasible
        state (e.g. obtained by a heuristic from the current node).

        It is never called by default: call
        ``BranchAndBound.primal_heuristic(node)`` from a search callback.

        Be careful not to modify the current problem instance,
        but return a new one.

        Returns
        -------
        Optional[Problem]
            Problem modified in a primal heuristic form, or None
            (in case not implemented)
        """
        return None

    cpdef double stronger_bound(self):
        """Placeholder for stronger bound implementation.
        If implemented, it should return a lower bound at least as strong
        as `calc_bound`, typically more expensive to compute.

        It is never called by default: call
        ``BranchAndBound.upgrade_bound(node)`` from a search callback
        (e.g. only when the regular bound cannot prune the node).

        Returns
        -------
        float
            Better lower bound if implemented, or simply current
        """
        return self.solution.lb

    cpdef void upgrade_bound(self, double new_lb):
        """Sets the solution lower bound to ``new_lb`` if it is greater
        than the current one."""
        if new_lb > self.solution.lb:
            self.solution.set_lb(new_lb)

    cpdef Problem copy(self, bool deep=True):
        """Returns a copy of the problem instance.

        In a shallow copy, the ``solution`` attribute is a reference to the
        original one. Use `child_copy` to initialize a copy with a new
        solution.

        Parameters
        ----------
        deep : bool, optional
            Whether to perform a deep copy, by default True

        Returns
        -------
        Problem
            Copy of the current instance
        """
        if deep:
            return self.deep_copy()
        return self.shallow_copy()

    cpdef Problem child_copy(self, bool deep=False):
        """Returns a copy of the problem instance with a new solution.

        This method is useful to safely initialize a copy of the problem
        with a new solution, without modifying the original one.

        Parameters
        ----------
        self : Problem
            Current instance

        deep : bool, optional
            Whether to perform a deep copy, by default False

        Returns
        -------
        Problem
            Copy of the current instance with a new solution
        """
        cdef:
            Problem other

        if deep:
            other = self.deep_copy()
        else:
            other = self.shallow_copy()
        other.solution = Solution()
        return other
